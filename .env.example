# -----------------------------------------------------------------------------
# En Compañía — Frontend (Next.js)
# Copiá este archivo como `.env.local` y completá los valores reales.
# `.env.local` está ignorado por Git: nunca lo subas al repositorio.
# -----------------------------------------------------------------------------

# URL del proyecto Supabase.
# Local (supabase start): http://127.0.0.1:54321
# Remoto: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clave publishable (pública). Es segura en el navegador porque el acceso
# real a los datos lo controlan las políticas RLS de PostgreSQL.
# Local: la muestra `npx supabase status` (carpeta EnCompa-iaBack).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# URL pública del sitio (SEO, metadatos, enlaces absolutos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IMPORTANTE: NO agregar aquí SUPABASE_SERVICE_ROLE_KEY ni la secret key.
# El frontend no la necesita: todas las operaciones del CMS se hacen con la
# sesión del administrador y se autorizan mediante RLS.
#
# Tests E2E: ver `.env.test.example` (archivo aparte, solo para Supabase local).

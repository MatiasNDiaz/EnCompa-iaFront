# -----------------------------------------------------------------------------
# Tests E2E (Playwright) — SOLO contra Supabase LOCAL.
# Copiá como `.env.test.local` (ignorado por Git).
# El setup de Playwright crea estos usuarios al empezar y los borra al terminar,
# y se niega a correr si NEXT_PUBLIC_SUPABASE_URL no es local.
# -----------------------------------------------------------------------------

# Secret key de DEMO del entorno local (`npx supabase status` en EnCompa-iaBack).
# Nunca poner acá una clave de un proyecto remoto.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

E2E_ADMIN_EMAIL=e2e-admin@test.local
E2E_ADMIN_PASSWORD=cambiar-por-una-contraseña-aleatoria-Aa1
E2E_USER_EMAIL=e2e-user@test.local
E2E_USER_PASSWORD=cambiar-por-otra-contraseña-aleatoria-Aa1
